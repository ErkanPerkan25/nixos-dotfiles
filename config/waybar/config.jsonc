{
    "layer": "top",
    "modules-left": ["custom/archicon","hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": ["wlr/taskbar","cpu", "memory","pulseaudio", "network","disk","battery"],
    "spacing": 10,
    "custom/archicon": {
       "format": " ",
       "on-click": "rofi -show drun",
       "tooltip": false
     },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 28
    },
    "pulseaudio": {
            "format": "{icon}{volume}% ",
            "format-bluetooth": " {volume}% {icon}",
            "format-muted": "",
            "format-icons": {
                "alsa_output.pci-0000_00_1f.3.analog-stereo": " ",
                "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "  ",
                "headphone": " ",
                "default": [" ", " "]
            },
            "scroll-step": 1,
            "on-click": "pavucontrol",
            "ignored-sinks": ["Easy Effects Sink"]
    },
    "disk": {
        "interval": 30,
        "format": " {specific_used:0.1f}/{specific_total:0.1f} G",
        "unit": "GB"
        // 0.25 GB out of 2000.00 GB available. Alternatively 241.3MiB out of 1.9TiB available.
    },
    "cpu":{
        "interval": 10,
        "format": " {}%",
        "max-length": 10
    },
    "hyprland/workspaces": {
        "format": "{id} {icon}",
        "format-icons": {
            "active": " ",
            "default": " "
        },
        "persistent-workspaces": {
            "*": [
                1
            ]    
        },
        "sort-by-number": true
    },
   "network": {
        "format": "{ifname}",
        "format-wifi": "  {essid} - {bandwidthTotalBytes} ",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗 ",
        "format-disconnected": "", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗 ",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)  ",
        "tooltip-format-ethernet": "{ifname}  ",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 10
    },    
    "battery": {
        "interval": 60,
        "format": "{capacity}% {icon}",
        "full-at": 90,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format-icons": [" ", " ", " ", " ", " "],
        "max-length": 30,
        "design-capacity": false
    },
    "clock": {
        "format": "{:%d. %b  %H:%M}",
        "timezone": "America/Indiana/Indianapolis"
    },
    "memory" : {
        "interval": 30,
        "format": " {used:0.1f}G/{total:0.1f}G"
    },
    "custom/separator": {
        "format": "|"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "all-outputs": true,
        "active-first": false,
        "tooltip-format": "{name}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "rofi",
            "kitty",
            "ghostty"
        ]
    },
    "bluetooth": {
        // "controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
        "format": " {status}",
        "format-disabled": "", // an empty format will hide the module
        "format-connected": " {num_connections} connected",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    }
}
